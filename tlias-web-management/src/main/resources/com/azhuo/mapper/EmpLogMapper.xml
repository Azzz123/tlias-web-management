<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--解释foreach标签
    collection: 集合名称，这里是 exprList
    item: 集合中的每个元素，这里是 expr
    separator: 每个元素之间的分隔符，这里是逗号
-->

<mapper namespace="com.azhuo.mapper.EmpLogMapper">
    <!-- 添加员工操作日志 -->
    <insert id="insert" parameterType="com.azhuo.pojo.EmpLog">
        insert into emp_log (operate_time, info) values (#{operateTime}, #{info})
    </insert>
</mapper>
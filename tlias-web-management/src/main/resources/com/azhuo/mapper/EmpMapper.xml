<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.azhuo.mapper.EmpMapper">
    <!-- 分页查询员工列表 -->
    <select id="list" resultType="com.azhuo.pojo.Emp">
        SELECT e.*, d.name
        FROM emp AS e
        LEFT JOIN dept AS d
        ON e.dept_id = d.id
        <where>
            <if test="name != null and name != ''">
                e.name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="gender != null">
                AND e.gender = #{gender}
            </if>
            <if test="begin != null and end != null">
                AND e.entry_date BETWEEN #{begin} AND #{end}
            </if>
        </where>
        ORDER BY e.update_time DESC
    </select>

    <!-- 新增员工 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO emp
        (username, name, gender, phone, job, salary, image, entry_date, dept_id, create_time, update_time)
        VALUES
        (#{username}, #{name}, #{gender}, #{phone}, #{job}, #{salary}, #{image}, #{entryDate}, #{deptId}, #{createTime}, #{updateTime})
    </insert>

    <!-- 批量删除员工基本信息 -->
    <delete id="deleteByIds" parameterType="java.util.List">
        DELETE FROM emp
        WHERE id in
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 定义员工详情结果映射 -->
    <resultMap id="empResultMap" type="com.azhuo.pojo.Emp">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="name" column="name"/>
        <result property="gender" column="gender"/>
        <result property="phone" column="phone"/>
        <result property="job" column="job"/>
        <result property="salary" column="salary"/>
        <result property="image" column="image"/>
        <result property="entryDate" column="entry_date"/>
        <result property="deptId" column="dept_id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <collection property="exprList" ofType="com.azhuo.pojo.EmpExpr">
            <id property="id" column="exprId"/>
            <result property="company" column="company"/>
            <result property="job" column="job"/>
            <result property="begin" column="begin"/>
            <result property="end" column="end"/>
        </collection>
    </resultMap>

     <!-- 根据ID查询员工详情 -->
    <select id="getById" resultMap="empResultMap">
        SELECT e.*,
               ee.id AS exprId,
               ee.company,
               ee.job,
               ee.begin,
               ee.end
        FROM emp AS e
        LEFT JOIN emp_expr AS ee
        ON e.id = ee.emp_id
        WHERE e.id = #{id}
    </select>

    <!-- 根据ID更新员工基本信息,使用if判断各个字段是否更新，复用性高 -->
    <!-- set标签会生成set关键字，并自动去掉最后一个逗号 -->
    <update id="updateById">
        UPDATE emp
        <set>
            <if test="username != null and username != ''">
                username = #{username},
            </if>
            <if test="password != null and password != ''">
                password = #{password},
            </if>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="gender != null">
                gender = #{gender},
            </if>
            <if test="phone != null and phone != ''">
                phone = #{phone},
            </if>
            <if test="job != null and job != ''">
                job = #{job},
            </if>
            <if test="salary != null">
                salary = #{salary},
            </if>
            <if test="image != null and image != ''">
                image = #{image},
            </if>
            <if test="entryDate != null">
                entry_date = #{entryDate},
            </if>
            <if test="deptId != null">
                dept_id = #{deptId},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 查询员工岗位分布数据 -->
    <select id="countEmpJobData" resultType="java.util.Map">
        SELECT
            (CASE
                 WHEN job = 1 THEN '班主任'
                 WHEN job = 2 THEN '讲师'
                 WHEN job = 3 THEN '学工主管'
                 WHEN job = 4 THEN '教研主管'
                 WHEN job = 5 THEN '咨询师'
                 ELSE '其他'
                END) AS pos,
            COUNT(*) AS num
        FROM emp
        GROUP BY job
        ORDER BY num
    </select>

     <!-- 查询员工性别分布数据 -->
     <select id="countEmpGenderData" resultType="java.util.Map">
         SELECT
             IF(gender = 1, '男性员工', '女性员工') AS gender,
             COUNT(*) AS value
         FROM emp
         GROUP BY gender
    </select>

    <!-- 查询全部员工 -->
    <select id="getAll" resultType="com.azhuo.pojo.Emp">
        SELECT * FROM emp
    </select>

    <!-- 根据部门ID查询员工数量 -->
    <select id="countByDeptId" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM emp WHERE dept_id = #{id}
    </select>

</mapper>

